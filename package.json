{
  "name": "demo-devops-nodejs",
  "version": "1.0.0",
  "description": "API REST de usuarios para prueba técnica DevOps de Devsu",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.js?$": "babel-jest"
    },
    "collectCoverage": false,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "collectCoverageFrom": [
      "index.js",
      "users/**/*.js",
      "shared/**/*.js"
    ]
  },
  "author": "Devsu",
  "dependencies": {
    "dotenv": "16.0.3",
    "express": "4.18.2",
    "sequelize": "6.31.0",
    "sqlite3": "5.1.6",
    "yup": "1.0.2"
  },
  "devDependencies": {
    "@babel/preset-env": "7.21.4",
    "@types/express": "4.17.17",
    "babel-jest": "29.5.0",
    "eslint": "8.57.0",
    "jest": "29.5.0",
    "supertest": "6.3.3"
  }
}
