# Copy this file to terraform.tfvars and fill in your real values.
# terraform.tfvars is gitignored so project-specific data is not committed.

project_id = "my-gcp-project"      # REQUIRED: your GCP project ID
region     = "us-central1"
zone       = "us-central1-a"

cluster_name = "demo-devops-cluster"
node_count   = 2
machine_type = "e2-small"

artifact_repo_id = "demo-devops-nodejs"
